{
  "name": "philoset",
  "version": "1.3.3",
  "private": true,
  "description": "Add curated engineering principles and programming philosophies to any project as ready-to-edit Markdown files.",
  "keywords": [
    "best-practices",
    "code-quality",
    "conventions",
    "developer-tools",
    "documentation",
    "engineering",
    "markdown",
    "opinionated",
    "philosophy",
    "principles",
    "standards",
    "team"
  ],
  "homepage": "",
  "bugs": {
    "url": "https://github.com/johndeniel/Philoset/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johndeniel/Philoset.git"
  },
  "license": "MIT",
  "author": "johndeniel <johndeniel.d37@gmail.com> (https://github.com/johndeniel)",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "preferGlobal": true,
  "bin": {
    "philoset": "bin/postinstall.js"
  },
  "files": [
    "bin/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "prepublishOnly": "node --check bin/postinstall.js"
  },
  "dependencies": {
    "next": "^16.2.7",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  },
  "overrides": {
    "zod": "4.3.6"
  }
}
