  "author": "johndeniel <johndeniel.d37@gmail.com> (https://github.com/johndeniel)",
  "type": "module",
  "bin": {
    "philoset": "bin/postinstall.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johndeniel/Philoset.git"
  },
  "preferGlobal": true,
